<Window x:Class="HackerOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        IsHitTestVisible="False">

    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ShakeTransform" X="0" Y="0"/>
        </Grid.RenderTransform>

        <!-- ── Phase 1: Subtle glitch artifacts (corners + scan flicker) ── -->
        <Canvas x:Name="GlitchCanvas" Opacity="0">
            <Rectangle x:Name="TL" Canvas.Left="0"   Canvas.Top="0"    Width="60" Height="3"  Fill="#8000FF00"/>
            <Rectangle                Canvas.Left="0"   Canvas.Top="0"    Width="3"  Height="60" Fill="#8000FF00"/>
            <Rectangle x:Name="TR"   Canvas.Right="0" Canvas.Top="0"    Width="60" Height="3"  Fill="#8000FF00" HorizontalAlignment="Right"/>
            <Rectangle                                  Canvas.Top="0"    Width="3"  Height="60" Fill="#8000FF00" HorizontalAlignment="Right"/>
            <Rectangle x:Name="BL"   Canvas.Left="0"                    Width="60" Height="3"  Fill="#8000FF00" VerticalAlignment="Bottom"/>
            <Rectangle                Canvas.Left="0"                    Width="3"  Height="60" Fill="#8000FF00" VerticalAlignment="Bottom"/>
            <Rectangle                                                    Width="60" Height="3"  Fill="#8000FF00" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <Rectangle                                                    Width="3"  Height="60" Fill="#8000FF00" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <Rectangle x:Name="Glitch1" Width="1920" Height="4"  Fill="#60FF0000" Canvas.Top="200" Opacity="0"/>
            <Rectangle x:Name="Glitch2" Width="1920" Height="6"  Fill="#6000FFFF" Canvas.Top="600" Opacity="0"/>
            <Rectangle x:Name="Glitch3" Width="1920" Height="4"  Fill="#60FF00FF" Canvas.Top="900" Opacity="0"/>
        </Canvas>

        <!-- ── Phase 2: ctOS-style boot breach overlay ── -->
        <Grid x:Name="BootGrid" Opacity="0" Background="#DD000000">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock x:Name="LogoText"
                           Text="ctOS 2.0 :: ROOT BREACH MODULE"
                           FontFamily="Consolas"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF00FF66"
                           HorizontalAlignment="Center"
                           Opacity="0"
                           Margin="0,0,0,4"/>

                <Rectangle x:Name="SepLine" Height="2" Width="0" Fill="#FF00FF66" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- RGB-split glitch title -->
                <Grid x:Name="BootTitleWrap" HorizontalAlignment="Center">
                    <TextBlock x:Name="BootTitleGhostR" Text="UNAUTHORIZED ACCESS DETECTED"
                               FontFamily="Consolas" FontSize="34" FontWeight="Black"
                               Foreground="#AAFF0040" Opacity="0"/>
                    <TextBlock x:Name="BootTitleGhostB" Text="UNAUTHORIZED ACCESS DETECTED"
                               FontFamily="Consolas" FontSize="34" FontWeight="Black"
                               Foreground="#AA00E0FF" Opacity="0"/>
                    <TextBlock x:Name="BootTitle"
                               Text="UNAUTHORIZED ACCESS DETECTED"
                               FontFamily="Consolas"
                               FontSize="34"
                               FontWeight="Black"
                               Foreground="#FFFF0000"
                               Opacity="0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF0000" BlurRadius="35" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="BootSub"
                           Text="ROOT SHELL ACQUIRED — EVERYTHING YOU HAVE IS NOW OURS"
                           FontFamily="Consolas"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FFFF8800"
                           HorizontalAlignment="Center"
                           Opacity="0"
                           Margin="0,10,0,30"/>

                <Border Width="640" Height="24" BorderBrush="#FF00FF66" BorderThickness="2" Margin="0,0,0,8">
                    <Grid>
                        <Rectangle x:Name="ScanBar" Width="0" HorizontalAlignment="Left" Fill="#AA00FF66"/>
                        <TextBlock x:Name="ScanLabel" Text="BREACHING..." FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="LogList" Width="640" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       Foreground="#FF00EE44" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="HudTL" Grid.Row="0" Text="[SYS_ID: 0xDEADBEEF]" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                       Foreground="#AA00FF66" Margin="24" VerticalAlignment="Top" HorizontalAlignment="Left" Opacity="0"/>
            <TextBlock x:Name="HudTR" Grid.Row="0" Text="CONN: ESTABLISHED" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                       Foreground="#AA00FF66" Margin="24" VerticalAlignment="Top" HorizontalAlignment="Right" Opacity="0"/>
            <TextBlock x:Name="HudBL" Grid.Row="2" Text="FIREWALL: BYPASSED" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                       Foreground="#AAFF4400" Margin="24" VerticalAlignment="Bottom" HorizontalAlignment="Left" Opacity="0"/>
            <TextBlock x:Name="HudBR" Grid.Row="2" Text="ENCRYPTION: DISABLED" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                       Foreground="#AAFF4400" Margin="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Opacity="0"/>
        </Grid>

        <!-- ── Phase 3: Full takeover ── -->
        <Grid x:Name="TakeoverGrid" Opacity="0" Background="#FA000000">

            <Canvas x:Name="CodeRainCanvas" ClipToBounds="True"/>

            <Rectangle x:Name="Vignette" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="Transparent" Offset="0.35"/>
                        <GradientStop Color="#AAFF0000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Canvas x:Name="SkullCanvas"
                        HorizontalAlignment="Center"
                        Opacity="0">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="SkullShakeTransform" X="0" Y="0"/>
                    </Canvas.RenderTransform>
                    <Canvas.Effect>
                        <DropShadowEffect Color="#00FF00" BlurRadius="30" ShadowDepth="0"/>
                    </Canvas.Effect>
                </Canvas>

                <!-- RGB-split glitch title -->
                <Grid x:Name="TakeTitleWrap" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock x:Name="TakeTitleGhostR" Text="YOU HAVE BEEN COMPROMISED"
                               FontFamily="Consolas" FontSize="52" FontWeight="Black"
                               Foreground="#BBFF0040" Opacity="0"/>
                    <TextBlock x:Name="TakeTitleGhostB" Text="YOU HAVE BEEN COMPROMISED"
                               FontFamily="Consolas" FontSize="52" FontWeight="Black"
                               Foreground="#BB00E0FF" Opacity="0"/>
                    <TextBlock x:Name="TakeTitle"
                               Text="YOU HAVE BEEN COMPROMISED"
                               FontFamily="Consolas"
                               FontSize="52"
                               FontWeight="Black"
                               Foreground="#FFFF0000"
                               Opacity="0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF0000" BlurRadius="45" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="TakeSub"
                           Text="WELCOME  TO  THE  GAME"
                           FontFamily="Consolas"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="#FF00FF00"
                           HorizontalAlignment="Center"
                           Opacity="0"
                           Margin="0,8,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00FF00" BlurRadius="25" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Border Width="700" Height="24" BorderBrush="#FF00FF00" BorderThickness="2" Margin="0,30,0,6">
                    <Grid>
                        <Rectangle x:Name="ExfilBar" Width="0" HorizontalAlignment="Left">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#55440000" Offset="0"/>
                                    <GradientStop Color="#FFFF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock x:Name="ExfilLabel" Text="EXFILTRATING..." FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="TakeLog" Width="700" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       Foreground="#FFFF2222" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="BlinkMsg"
                       Text="// ALL YOUR BASE ARE BELONG TO US //"
                       FontFamily="Consolas"
                       FontSize="22"
                       FontWeight="Black"
                       Foreground="#FFFFFF00"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,34"
                       Opacity="0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FFFF00" BlurRadius="25" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <Rectangle x:Name="RedFlash" Fill="Red" Opacity="0" IsHitTestVisible="False"/>
            <Rectangle x:Name="WhiteFlash" Fill="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ── Full-screen static / noise layer — drawn above everything ── -->
        <Image x:Name="StaticNoiseImage" Opacity="0" IsHitTestVisible="False" Stretch="Fill"/>
        <Rectangle x:Name="BlackoutFlash" Fill="Black" Opacity="0" IsHitTestVisible="False"/>

    </Grid>
</Window>
